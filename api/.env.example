# Copie para .env e ajuste se necessário.
# Sem host = socket local com autenticação peer (usuário Linux = papel do Postgres).
CONDOHUB_DATABASE_URL=postgresql+psycopg:///condohub
# Por TCP, com senha:
# CONDOHUB_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/condohub
CONDOHUB_ECHO_SQL=false
